# Copy to .env and edit.  NEVER commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development            # development | production | testing
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60

# SQLite by default (instance/scamshield.db). Leave empty to use the default.
DATABASE_URL=

# Comma-separated list of allowed frontend origins (Vite default shown)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Upload limits
MAX_CONTENT_LENGTH=4194304     # hard cap on any request body (4 MB)
QR_MAX_UPLOAD_BYTES=2097152    # QR image cap (2 MB)

# Rate limits (Flask-Limiter syntax)
RATELIMIT_AUTH=10 per minute
RATELIMIT_ANALYZE=30 per minute
RATELIMIT_DEFAULT=300 per minute
RATELIMIT_STORAGE_URI=memory://

# ---- ML engine integration -------------------------------------------------
# Folder that CONTAINS the `ml` package (default: the folder above backend/).
ML_PROJECT_PATH=
# "module:function" for each analyzer. Change these if the ML project uses
# different names.
ML_TEXT_ANALYZER=ml.inference.text_analyzer:analyze_text
ML_URL_ANALYZER=ml.inference.url_analyzer:analyze_url
ML_PAYLOAD_ANALYZER=ml.inference.qr_analyzer:analyze_payload
# Optional: function returning a dict of model metadata
ML_INFO_FUNC=

# ---- Gmail -----------------------------------------------------------------
# Real Gmail OAuth is NOT implemented in this build (Demo Gmail Mode only).
# These are reserved names so secrets never end up in source code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
